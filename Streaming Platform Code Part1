        "\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "# Assuming 'separated_tags_df' and 'drama_filtered' DataFrames are already created as in the previous code.\n",
        "\n",
        "# Merge the separated tags with the original DataFrame to include the 'Released Year' column.\n",
        "merged_df = pd.merge(separated_tags_df, drama_filtered[['Title', 'Released Year']], on='Title', how='left')\n",
        "\n",
        "# Group by year and tag, then count occurrences.\n",
        "tag_counts_by_year = merged_df.groupby(['Released Year', 'Tag'])['Title'].count().reset_index(name='Count')\n",
        "\n",
        "# Sort by year and count.\n",
        "tag_counts_by_year = tag_counts_by_year.sort_values(['Released Year', 'Count'], ascending=[True, False])\n",
        "\n",
        "\n",
        "# Function to plot top tags over time for the Drama genre.\n",
        "def plot_top_tags_over_time(top_n=10):\n",
        "    plt.figure(figsize=(14, 8))\n",
        "    for tag in tag_counts_by_year['Tag'].unique()[:top_n]:\n",
        "        tag_data = tag_counts_by_year[(tag_counts_by_year['Tag'] == tag)]\n",
        "        plt.plot(tag_data['Released Year'], tag_data['Count'], label=tag)\n",
        "    plt.title(f'Top {top_n} Drama Tags Over Time')\n",
        "    plt.xlabel('Year')\n",
        "    plt.ylabel('Frequency')\n",
        "    plt.legend()\n",
        "    plt.grid(True)\n",
        "    plt.xticks(rotation=45, ha='right')\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
